object Gold: TGold
  Left = 192
  Top = 107
  BorderIcons = [biSystemMenu, biMinimize]
  BorderStyle = bsSingle
  Caption = 'Guia completo de Gold/Silver'
  ClientHeight = 353
  ClientWidth = 533
