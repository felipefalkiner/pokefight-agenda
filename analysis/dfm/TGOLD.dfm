  Font.Style = []
  Menu = MainMenu1
  OldCreateOrder = False
  Position = poDesktopCenter
  PixelsPerInch = 96
  TextHeight = 13
  object BitBtn1: TBitBtn
    Left = 440
    Top = 320
    Width = 75
    Height = 25
    Caption = '&Fechar'
    TabOrder = 0
    OnClick = BitBtn1Click
    Kind = bkCancel
  end
  object RichEdit1: TRichEdit
    Left = 16
    Top = 16
    Width = 497
    Height = 289
    Lines.Strings = (
      ''
      'INICIANDO'
      ''
      'Quando voc'#234' inicia o jogo, a primeira quest'#227'o que o jogo '#233' a horta do dia. A segunda pergunta '#233' o '
      'minuto.'
      ''
      'Voc'#234' iniciar'#225' o jogo em sua casa na cidade de Wakaba, Des'#231'a a escada e fale com sua m'#227'e. Ela '
      'perguntar'#225' o dia da semana, e te dar'#225' o Pok'#233'Gear. Agora v'#225' at'#233' a casa na parte de cima na '
      'esquerda da cidade. '#201' o laborat'#243'rio do professor Utsugi. Quando voc'#234' entra no laborat'#243'rio, ele '
      'falar'#225' algo, e te dar'#225' escolha de tr'#234's pok'#233'mons: um de fogo, '#225'gua e planta. Escolha um.'
      ''
      'Antes de voc'#234' sair, um assistente do professor lhe dar'#225' o item POTION.'
      ''
      'CIDADE DE YOSHINO'
      ''
      'Seu destino '#233' a cidade de Yoshino, ao oesre. Aumente o n'#237'vel do seu pok'#233'mon se quiser. Se voc'#234' '
      'quiser recarregar seu pok'#233'mon volte at'#233' o laborat'#243'rio e mexa no computador. Ele funciona como um '
      'centro pok'#233'mon.'
      ''
      'V'#225' at'#233' o oeste. Continue andando at'#233' voc'#234' chegar a cidade de Yoshino. Fale com o velhote no '
      'in'#237'cio da cidade, e ele lhe mostrar'#225' a cidade. Quando o "tour" acabar, ele lhe dar'#225' o mapa.'
      ''
      'V'#225' ao norte, e entre numa casa. L'#225', um cara lhe dar'#225' um item chamado "Spirit Fruit".'
      ''
      'V'#225' para o noroeste e entre numa casa. L'#225' voc'#234' encontrar'#225' o professor Oak.'
      ''
      'Ele lhe dar'#225' a Pok'#233'Dex. Ele tamb'#233'm lhe dar'#225' um ovo, que virar'#225' o Togepi.'
      ''
      'DE VOLTA A CIDADE DE WAKABA'
      ''
      'Volte at'#233' a cidade e entre no Shop. Agora, compre algumas pok'#233'bolas. '#201' um item que custa 200, e '
      #233' o que tem maior n'#250'mero de letras japonesas.'
      ''
      'Volte at'#233' sua cidade de origem (cidade de Wakaba). Ao chegar em sua cidade natal, um jovem '
      'surgir'#225' e lutar'#225' contra voc'#234'. '#201' o seu rival ! Derrote-o e continue indo para sua cidade e entre no '
      'laborat'#243'rio de Utsugi. A pol'#237'cia estar'#225' l'#225'. De um nome a seu rival, e o professor pegar'#225' o seu ovo '
      '(Topegi) para examinar. Volte para a segunda cidade (Yoshino). Ao sair, um assistente lhe dar'#225' 5 '
      'Pok'#233'bolas.'
      ''
      'A CIDADE DE KIKYOU E A INS'#205'GNIA DA ASA'
      ''
      'Neste ponto, voc'#234' deve pegar alguns Pok'#233'mons. Uma boa escolha '#233' capturar Otachi (o esquilo '
      'gordo) s'#243' pode ser capturado durante o dia. Ele pode aprender o Cut, e at'#233' o Surf! Outro bom '#233' o '
      'Pidgey, que pode aprender o Fly. V'#225' at'#233' a cidade de Kikyou. Derrote o lider do gin'#225'sio que usa '
      'pok'#233'mons voadores. Ganha a ins'#237'gnia da asa. Ele tamb'#233'm te d'#225' o TM 31 "Sand Hell". Utsugi o '
      'chamar'#225' ap'#243's sair do gin'#225'sio. Seu ovo est'#225' pronto.'
      ''
      'V'#225' at'#233' o centro Pok'#233'mon desta cidade e fale com o assistente do professor. Ele lhe dar'#225' seu ovo '
      'de '
      'volta, ele ficar'#225' na sua equipe, mas n'#227'o da pra us'#225'-lo. Mas em algum tempo ele virar'#225' o Togepi !!!'
      ''
      'Agora v'#225' at'#233' o norte da cidade, e entre no templo dos monges. Siga no templo at'#233' voc'#234' encontrar o '
      'chefe dos monges, que lutar'#225' contra voc'#234'. Se voc'#234' ganhar, voc'#234' ganhar'#225' o HM Flash. Use-o no '
      'BellSprout. Se voc'#234' ainda n'#227'o tem um, n'#227'o se preocupe, voc'#234' logo ir'#225' encontrar.'
      ''
      'A CIDADE DE HIWADA E A INS'#205'GNIA DE INSETO'
      ''
      'Agora, v'#225' at'#233' o sul para a cidade de Hiwada. Se voc'#234' tentar ir para o oeste, voc'#234' ser'#225' bolqueado '
      'por uma '#225'rvore. Neste matinhos h'#225' BellSprouts, Ekans, um Pok'#233'mon Samambaia e um Pok'#233'mon '
      'Ovelha.'
      ''
      'Entre no centro Pok'#233'mon e fale com o pescador para ganhar a vara de pescar. Entre na caverna '
      'logo abaixo, e v'#225' at'#233' o fim dela. Saia dela e v'#225' para o oeste. L'#225' voc'#234' chegar'#225' na cidade de '
      'Hiwada. Fale com Gentetsu, o fazedor de Pok'#233'Bolas na parte norte da cidade, e ele lhe pedir'#225' para '
      'salvar os Slowpokes que est'#227'o sendo muito capturados. Ele ent'#227'o sair'#225' da casa. Agora v'#225' at'#233' o '
      'in'#237'cio da cidade e entre na caverna que um cara estava bloqueando no in'#237'cio. Gantestu estar'#225' l'#225'. '
      'Mate todos os membros da Equipe Rocket, e Gantestu ficar'#225' feliz. Ele lhe dar'#225' uma Lure Ball.'
      ''
      'Agora, v'#225' at'#233' o Gym, e mate a lider para ganhar a ins'#237'gnia do Inseto. A lider tamb'#233'm lhe dar'#225' o TM '
      '49.'
      ''
      'Recarregue no centro Pok'#233'mon, e v'#225' at'#233' o oeste. Seu rival aparece de novo. Esta batalha '#233' um '
      'pouco dif'#237'cil, mas nem tanto se seus Pok'#233'mons estiver num n'#237'vel avan'#231'ado.'
      ''
      'A CIDADE DE KOGANE E A INS'#205'GNIA REGULAR'
      ''
      'V'#225' pela floresta, e brinque de correr atr'#225's de um Farfetch''d para ganhar o HM CUT. Ensine-o '#225' '
      'algum Pok'#233'mon e va indo at'#233' o norte, para chegar na cidade de Kogane. Explore a cidade, mas '
      'n'#227'o entre no Gym ainda. Voc'#234' encontrar'#225' um Coin Case num tunnel debaixo da terra (voc'#234' n'#227'o '
      'pode entrar ainda) e uma bicicleta na loja de bicicletas.'
      ''
      'V'#225' at'#233' a torre de r'#225'dio (o pr'#233'dio escuro no lado oeste da cidade), e fale com a '#250'ltima mulher do '
      'balc'#227'o. Responda as perguntas corretamente (chute, pois voc'#234' provavelmente n'#227'o entender'#225' '
      'nada) e voc'#234' ganhar'#225' o item Radio Card.'
      ''
      'Voc'#234' pode ir agora at'#233' o Gym, mas cuidado: '#233' uma batalha muito dif'#237'cil, pois a l'#237'der usa um '
      'Pok'#233'mon Vaca muito fore, com level 20, ent'#227'o, treine seus Pok'#233'mons at'#233' mais do que este level. '
      'Salve antes do Gym !!'
      ''
      'Voc'#234' receber'#225' a ins'#237'gnia Regular se voc'#234' vencer. Ela n'#227'o lhe dar'#225' a ins'#237'gnia de primeira, ent'#227'o, ao '
      'vencer, tente sair do Gym, e uma mulher falar'#225' com voc'#234', ent'#227'o fale com a lider do GYM de novo e '
      'ela lhe dar'#225' a ins'#237'gnia !!!'
      ''
      'A CIDADE DE ENJU E A INS'#205'GNIA FANTASMA'
      ''
      'Saia do Gym, e va at'#233' a casa da direita, no topo da cidade. Fale com a garota perto das flores, e ela '
      'lhe dara um pouco de l'#237'quido de Squirtle. V'#225' at'#233' o norte, e continue indo at'#233' voc'#234' chegar bem l'#225' '
      'em '
      'cima, onde enfrentar'#225' um treinador que s'#243' tem Voltorbs. Ap'#243's a luta, fale com ele e ele. Continue '
      'subindo at'#233' chegar em uma '#225'rvore estranha. Voc'#234' deve agora ter Pok'#233'Bolas ou Ultra Bolas, pois '
      'haver'#225' um Pok'#233'mon que s'#243' aparece uma vez no jogo. Mexa na estranha '#225'rvore. Ela virar'#225' um '
      'Pok'#233'mon !!! Capture-o, pois ele s'#243' aparece uma vez no jogo. Ap'#243's mat'#225'-lo ou captur'#225'-lo, va para a '
      'direita e fale com o homem gordo. Ele lhe dar'#225' um TM importante, o TM 08, que funciona como um '
      'HM. '#201' o Rock Breaker. Recarregue seus Pok'#233'mons no centro desta cidade, e volte para o local '
      'onde estava a '#225'rvore e siga para a esquerda. Ent'#227'o v'#225' subindo at'#233' chegar numa cidade.'
      ''
      'Agora voc'#234' est'#225' na cidade de Enju. Voc'#234' encontrar'#225' seu rival no centro Pok'#233'mon, mas n'#227'o lutar'#225'. '
      'V'#225' na casa '#225' esquerda do centro Pok'#233'mon, fale com o menino e receba o Item Finder.'
      ''
      'Agora v'#225' at'#233' a casa acima do centro Pok'#233'mon e derrote todas as garotas que est'#227'o dan'#231'ando. '
      'Elas usam evolu'#231#245'es do Eevee, incluindo as 2 novas evolu'#231#245'es que ele tem. Fale com o homem '
      'nesta sala ap'#243's derrot'#225'-las. Ele lhe dar'#225' o HM de Surf.'
      ''
      'Agora v'#225' at'#233' o Gym. Para chegar ao lider, voc'#234' deve percorrer um caminho secreto, mas '#233' bem '
      'f'#225'cil. Basta salvar a cada passo em sucesso que voc'#234' der, e voc'#234' chegar'#225' !!! Derrote o l'#237'der que '
      'usa Pok'#233'mons Fantasmas. Voc'#234' receber'#225' a Ins'#237'gnia Fantasma. Ele tamb'#233'm lhe dar'#225' o TM 30.'
      ''
      'V'#225' at'#233' o templo menor na parte de cima na esquerda da cidade. Seu rival est'#225' l'#225'. Quebre as pedras '
      'usando o TM 08 - Rock Breaker. Ande por la e caia em um buraco. Encontre um local onde h'#225' 3 '
      'Pok'#233'mons. Eles ir'#227'o fugir. Ainda n'#227'o sei pra onde eles foram... Ande para baixo e suba as escadas. '
      'Saia do templo.'
      ''
      'A CIDADE DE ASAGI'
      ''
      'V'#225' at'#233' o oeste para a cidade de Asagi. Voc'#234' pode parar na fazenda de Mirutank''s se voc'#234' quiser. '
      'Mirutanks s'#227'o Pok'#233'mons Vaca. Um deles, da fazenda, est'#225' doente. Alimente-o com de 8 a 10 Spirit '
      'Fruits e ele melhorar'#225'. Ent'#227'o, fale com a m'#227'e da casa, e ela lhe dara um TM. Voc'#234' pode comprar '
      'leite do pai da casa, que recarrega seu life. Voc'#234' n'#227'o precisa de ir na fazenda, pois n'#227'o h'#225' nada de '
      'bom l'#225'.'
      ''
      'Na cidade, voc'#234' ver'#225' que o Gym est'#225' vazio. Suba no farol e fale com Mikan no topo. Seu Pok'#233'mon '
      'est'#225' doente, e voc'#234' precisa da medicina. Ignore este gin'#225'sio por enquanto.'
      ''
      'Saia do farol v'#225' at'#233' a '#250'ltima casa antes da praia. Fale com o marinheiro e ganhe o HM Strenght.'
      ''
      'A CIDADE DE TABAN E A INS'#205'GNIA DE SHOQUE'
      ''
      'Agora, use o HM Surf e v'#225' pela praia na parte de baixo da praia e nade at'#233' a cidade de Taban e '
      'derrote o l'#237'der do Gym e ganhe a ins'#237'gnia de choque. O l'#237'der tamb'#233'm lhe dar'#225' o TM 01 !'
      ''
      'Fale com a mulher do lado de fora do Gym e ganhe o HM Fly. Entre na '#218'LTIMA casa na parte de '
      'baixo da cidade de Taban. Fale com o homem. Ele lhe dar'#225' a medicina que voc'#234' precisa para curar '
      'o Pok'#233'mon da l'#237'der do 6'#186' Gym.'
      ''
      'DE VOLTA A CIDADE DE ASAGI E INS'#205'GNIA DE A'#199'O'
      ''
      'Agora, voe at'#233' a cidade de Asagi (Akela que a l'#237'der n'#227'o estava no Gym) e v'#225' at'#233' o farol, e suba at'#233' '
      'encontrar a l'#237'der. Fale com ela e ela ira sair do farol. Saia tamb'#233'm e v'#225' at'#233' o Gym. Derrote-a e '
      'ganhe '
      'a ins'#237'gnia de A'#231'o. Ela lhe da o TM 24.'
      ''
      'A CIDADE DE CHOJU E INS'#205'GNIA DE GELO'
      ''
      'Voe at'#233' a cidade de Enju (aquela que tem as 5 garotas que dan'#231'am com evolu'#231#227'o do Eevee) e v'#225' '
      'at'#233' a o leste. Entre em uma caverna, e no fim dela voc'#234' chegar'#225' na cidade de Choju. Um cara est'#225' '
      'bloqueando a porta do Gym, e voc'#234' n'#227'o pode entrar. V'#225' para o norte, entre num lago e capture o '
      'Gyarados vermelho. '#201' um Gyarados especial. Ap'#243's captur'#225'-lo, Lance estar'#225' olhando um cartaz. '
      'Fale '
      'com ele e ele desaparecer'#225'.'
      ''
      'Volte na cidade e entre em uma das casas. Lance estar'#225' l'#225', e vai te mostrar o caminho para o '
      'quartel general da Equipe Rocket. Entre no QG. Derrote o pesquisador no computador, e examine o '
      'computador para apertar um bot'#227'o. No pr'#243'ximo andar, voc'#234' encontrar'#225' Lance de novo. Ele vai '
      'recarregar seus Pok'#233'mons. Derrote todos os membros da equipe Rocket em todos os andares. Ap'#243's '
      'derrotar TODOS, entre na sala do chefe, e derrote-o. Fale com o p'#225'ssaro, e desc'#225' at'#233' o andar que '
      'tem uma grande m'#225'quina, atr'#225's de um port'#227'o. Derrote os membros da equipe Rocket com a ajuda '
      'de Lance, e v'#225' at'#233' a sala de gera'#231#227'o. Derrote os 3 Electrodes do lado esquerdo, capture um se '
      'quiser. Ap'#243's isso, Lance lhe dar'#225' o HM 06 - Whirlpool.'
      ''
      'Agora, saia da lojinha e entre no Gym. Derrote-o e ganhe a ins'#237'gnia de gelo e o TM 16.'
      ''
      'A CIDADE DE KOGANE E A TORRE DE RADIO'
      ''
      'Agora que voc'#234' j'#225' tem sete ins'#237'gnias, voc'#234' receber'#225' um telefonema do professor Utsugi lhe '
      'chamando para a cidade de Kogane. '#201' a cidade que tem a esta'#231#227'o de Radio. A maior cidade do '
      'jogo, onde voc'#234' pegou a bicicleta. Voe at'#233' l'#225'. Entre na torre de R'#225'dio e derrote todos os membros '
      'da Equipe Rocket. Haver'#225' um port'#227'o em um dos andares. Ignore-o por enquanto. No topo da tore, '
      'derrote o chefe. Voc'#234' vai ganhar uma chave.'
      ''
      'Saia da Torre de Radio, e v'#225' at'#233' o norte, entre numa casa e entre na passagem subterr'#226'nea. Des'#231'a '
      'um pouco, e vire para a direita num estreito caminho (dif'#237'cil de ver). Se voc'#234' descer, voc'#234' chegar'#225' '
      'numa '#225'rea da cidade com o Cassino, e voc'#234' pode us'#225'-lo se quiser. Atravesse o estreito caminho, '
      'haver'#225' uma porta. Aperte o A na frente da porta, e use a chave para abri-la. Agora passe pela porta. '
      'Esteja preparado, pois voc'#234' lutar'#225' contra seu rival.'
      ''
      'Derrote 3 membros da Equipe Rocket, e mexa nas coisinhas azuis que est'#227'o na parede. As '
      'portinhas abaixo ir'#227'o se abrir. Esta parte '#233' muito chata e demorada. Fique mexendo nas coisinhas '
      'azuis at'#233' que as portas se abram e voc'#234' poder'#225' ir at'#233' a parte de baixo. '#201' na cagada mesmo ! Fique '
      'apertando os negocinhos azuis e v'#225' checar se as portas abriram.'
      ''
      'Depois de conseguir, des'#231'a e continue indo, at'#233' encontrar um homem diferente dos outros. Fale '
      'com ele, e ele lhe dar'#225' um item. Agora suba as escadas. Voc'#234' est'#225' agora numa lan'#231'a com um '
      'monte de gente andando pra l'#225' e pra c'#225'. Entre no elevador logo acima. Voc'#234' est'#225' dentro do Shop '
      '!!! Suba at'#233' o andar 1. L'#225', saia pela porta. Entre na torre de Radio de novo. Desta vezes, passe '
      'pelo port'#227'o que estava fechado. Derrote os membros da Equipe Rocket restantes, e pronto ! O '
      'oitavo Gym j'#225' est'#225' aberto !'
      ''
      'A CIDADE DE FUSB'
      ''
      'Agora que voc'#234' j'#225' tem sete ins'#237'gnias, voc'#234' receber'#225' um telefonema do professor Utsugi lhe '
      'chamando para a cidade de Kogane. '#201' a cidade que tem a esta'#231#227'o de Radio. A maior cidade do '
      'jogo, onde voc'#234' pegou a bicicleta. Voe at'#233' l'#225'. Entre na torre de R'#225'dio e derrote todos os membros '
      'da Equipe Rocket. Haver'#225' um port'#227'o em um dos andares. Ignore-o por enquanto. No topo da tore, '
      'derrote o chefe. Voc'#234' vai ganhar uma chave.'
      ''
      'Saia da Torre de Radio, e v'#225' at'#233' o norte, entre numa casa e entre na passagem subterr'#226'nea. Des'#231'a '
      'um pouco, e vire para a direita num estreito caminho (dif'#237'cil de ver). Se voc'#234' descer, voc'#234' chegar'#225' '
      'numa '#225'rea da cidade com o Cassino, e voc'#234' pode us'#225'-lo se quiser. Atravesse o estreito caminho, '
      'haver'#225' uma porta. Aperte o A na frente da porta, e use a chave para abri-la. Agora passe pela porta. '
      'Esteja preparado, pois voc'#234' lutar'#225' contra seu rival.'
      ''
      'Derrote 3 membros da Equipe Rocket, e mexa nas coisinhas azuis que est'#227'o na parede. As '
      'portinhas abaixo ir'#227'o se abrir. Esta parte '#233' muito chata e demorada. Fique mexendo nas coisinhas '
      'azuis at'#233' que as portas se abram e voc'#234' poder'#225' ir at'#233' a parte de baixo. '#201' na cagada mesmo ! Fique '
      'apertando os negocinhos azuis e v'#225' checar se as portas abriram.'
      ''
      'Depois de conseguir, des'#231'a e continue indo, at'#233' encontrar um homem diferente dos outros. Fale '
      'com ele, e ele lhe dar'#225' um item. Agora suba as escadas. Voc'#234' est'#225' agora numa lan'#231'a com um '
      'monte de gente andando pra l'#225' e pra c'#225'. Entre no elevador logo acima. Voc'#234' est'#225' dentro do Shop '
      '!!! Suba at'#233' o andar 1. L'#225', saia pela porta. Entre na torre de Radio de novo. Desta vezes, passe '
      'pelo port'#227'o que estava fechado. Derrote os membros da Equipe Rocket restantes, e pronto! O '
      'oitavo Gym j'#225' est'#225' aberto !'
      ''
      'A CIDADE DE FUSUBE E A INS'#205'GNIA DA F'#218'RIA'
      ''
      'Agora que voc'#234' acabou com a equipe Rocket, volte at'#233' a cidade de Choju (aquela que voc'#234' '
      'pegou '
      'p Gyarados, do Gym de gelo, no topo do mapa), e de la v'#225' para o leste, at'#233' a cidade de Fusube. '
      'Voc'#234' passar'#225' por uma caverna, dentro dela, pegue todas as Pok'#233'bolas que voc'#234' achar no ch'#227'o, '
      'pois uma delas '#233' o HM 07, e voc'#234' precisa de ter o HM 07 !!! Haver'#225' uma parte com buracos e '
      'pedras. Empurre todas as pedras para dentro dos buracos com o Strenght, ent'#227'o caia num buraco, '
      'e '
      'deslize no gelo para chegar ao centro, pegue a bola e suba a escada. Agora n'#227'o tem mais mist'#233'rio. '
      'Voc'#234' chegar'#225' na cidade de Fusube.'
      ''
      'Derrote o l'#237'der do '#250'ltimo gin'#225'sio, mas ele n'#227'o lhe dar'#225' a ins'#237'gnia. Use o Surf na '#225'rea atr'#225's do Gym, e '
      'entre na caverna. Suba um andar, e saia da caverna. Nade at'#233' o rodamoinho, e destrua-o usando o '
      'HM 06. Passe pelo local onde o rodamoinho estava e pegue o item. '#201' uma esp'#233'cie de Pok'#233'Bola '
      'muito boa !!! A l'#237'der do Gym surgir'#225', e lhe dar'#225' a ins'#237'gnia. Ela tamb'#233'm lhe dar'#225' o TM 24. Pronto ! '
      'Voc'#234' j'#225' tem todas as ins'#237'gnias !!'
      ''
      'PREPARANDO-SE PARA A LIGA POK'#201'MON'
      ''
      'Ap'#243's pegar a ins'#237'gnia e sair da caverna, voc'#234' receber'#225' um telefonema de professor Utsugi. Voe at'#233' '
      'sua cidade natal, e fale com ele. Voc'#234' receber'#225' a majestosa Master Ball. Use-a com sabedoria, de '
      'prefer'#234'ncia no Lugia ou Houou.'
      ''
      'Agora que voc'#234' tem todas as 8 ins'#237'gnias, voc'#234' pode ir para a liga Pok'#233'mon. Na sua cidade natal, '
      'va para a direita, e nade na '#225'gua, at'#233' encontrar um homem gordo. Fale com ele. Ele lhe dar'#225' o novo '
      'mapa. Olhe-o ! Reconhece este mundo ??? Sim ! S'#227'o as cidades de Red/Blue !'
      ''
      'Bem, voc'#234' precisar'#225' de bastante for'#231'a para combater os treinadores da liga Pok'#233'mon. Talvez voc'#234' '
      'deva procurar os 3 p'#225'ssaros legend'#225'rios, e, se voc'#234' joga a Gold, capture Houou. Se voc'#234' joga a '
      'silver, capture Lugia. Veja como logo abaixo:'
      ''
      'CAPTURANDO HOUOU OU LUGIA'
      ''
      'Houou (n'#186'250) est'#225' no templo legend'#225'rio. V'#225' para a cidade de Enju (a que tem as 5 garotas com '
      'evolu'#231#245'es do Eevee). Entre na casa no topo da cidade. Antes de voc'#234' ter as ins'#237'gnias, um cara '
      'barrava sua entrada. Agora voc'#234' pode entrar. Siga o caminho at'#233' voc'#234' chegar num templo. V'#225' at'#233' '
      'o topo, e Houou estar'#225' l'#225' (s'#243' na vers'#227'o Gold).'
      ''
      'Lugia (n'#186'249) est'#225' nas cavernas ao oeste da cidade de Taban (aquela cidade que '#233' uma ilha, no '
      'lado esquerdo do mapa). L'#225', come'#231'e a nadar no lado direito da cidade. H'#225' muitas cavernas nesta '
      #225'rea. Entre na '#250'ltima delas, a mais pra direita de todas. V'#225' indo nela at'#233' vo'#234' chegar numa parte com '
      #225'gua. Nade. Des'#231'a por uma correnteza (voc'#234' n'#227'o pode mais subir pelo lugar que voc'#234' veio). Entre '
      'em uma porta, e l'#225' est'#225' o Lugia.'
      ''
      'Estes Pok'#233'mons s'#227'o muito raros, e devem ser capturados com a Master Ball. '
      ''
      'NA LIGA POK'#201'MON'
      ''
      'De volta ao caminho para a liga Pok'#233'mon. Ap'#243's ganhar o segundo mapa do gord'#227'o, entre na '
      'caverna que h'#225' perto dele. Para subir as cachoeiras da caverna, use o HM 07 - WaterFall. '#201' uma '
      'caverna muito pequena. Ao sair da caverna, nade na direita, e v'#225' indo. Derrote alguns treinadores, '
      'e '
      'continue indo. Entre em outra caverna. Dentro dela, seu rival ir'#225' lutar contra voc'#234'. Ap'#243's derrot'#225'-lo, '
      'voc'#234' chegar'#225' num centro Pok'#233'mon. Recarregue seus Pok'#233'mons, pegue seus melhores Pok'#233'mons, '
      'e v'#225' enfrentar a Elite 5 subindo pelo corredor na direita do centro Pok'#233'mon. Salve ANTES de subir '
      'no corredor !!!'
      ''
      'Derrote a Elite 5 - eles s'#227'o 5 super-treinadores:'
      ''
      'Itsuki (Ps'#237'quico)'
      ''
      'Koga (Venenoso)'
      ''
      'Bruno (Lutadores)'
      ''
      'Karin (Muitos tipos)'
      ''
      'Lance (Drag'#227'o)'
      ''
      'A SEGUNDA PARTE DO JOGO'
      ''
      'Ap'#243's derrotar Lance, voc'#234' zerou o jogo. Zerou ??? N'#227'o... voc'#234' apenas passou da METADE dele ! '
      'O segundo mapa '#233' da segunda parte do jogo ! Voc'#234' agora jogar'#225' agora nas antigas cidades do '
      'jogo '
      'Pok'#233'mon Red/Blue ! O total de ins'#237'gnias do jogo '#233' de 16 ins'#237'gnias !'
      ''
      'A CIDADE DE VERMILION E A INS'#205'GNIA LARANJA'
      ''
      'Depois dos cr'#233'ditos, voc'#234' voltar'#225' a tela t'#237'tulo. Entre na primeira op'#231#227'o do menu. Professor Utsugi o '
      'chamar'#225'. V'#225' at'#233' ele. Ele lhe dar'#225' um ingresso em um navio.'
      ''
      'V'#225' at'#233' a cidade de Asagi (a que tem o farol, que a lider do Gym de l'#225' n'#227'o estava l'#225', lembrou??) '
      'des'#231'a e atravesse uma casa na parte de baixo da cidade. Entre no navio. Entre no seu quarto, '#233' o '
      'quarto mais da esquerda do primeiro corredor, que tem um marinheiro na frente. Use a cama para '
      'recarregar seus Pok'#233'mons. Tamb'#233'm h'#225' um computador no seu quarto. Explore todas as portas do '
      'navio, derrotando os treinadores.'
      ''
      'Em uma das portas, h'#225' um cara que n'#227'o luta com voc'#234'. Fale com ele. Ele o dir'#225' que sua filha '
      'desapareceu. Saia do quarto, e des'#231'a as escadas. Fale com o marinheiro que n'#227'o te deixa passar. '
      'Volte para o primeiro andar, e entre no quarto a direita do seu quarto. Derrote o marinheiro.'
      ''
      'Des'#231'a as escadas novamente, e derrote todos os treinadores deste andar. Fale com a menininha '
      'que est'#225' girando ao lado do capit'#227'o. Voc'#234' surgir'#225' no quarto dela.'
      ''
      'Nesta hora, seu navio j'#225' chegou. Voc'#234' agora est'#225' na cidade de Vermilion !!! V'#225' at'#233' o Gym e derrote '
      'Lt. Surge e ganhe a ins'#237'gnia Laranja (agora as ins'#237'gnias tem nome de cor).'
      ''
      'A CIDADE DE SAFFRON E A INS'#205'GNIA DE OURO'
      ''
      'V'#225' para o norte para a cidade de Saffron. Derrote a l'#237'der do Gym, Sabrina.'
      ''
      'Agora saia de Saffron pelo leste. Voc'#234' chegar'#225' em Lavender. Saia de lavender pelo norte, e entre '
      'na caverna (Rock Tunnel). Ilumie-a com o Flash e atravesse-a. Nade na '#225'gua at'#233' voc'#234' chegar na '
      'Power Plant (Usina de fo'#231'a). Fale com todo mundo l'#225'. Continue andando at'#233' chegar em uma cidade '
      '(Cerulean). Entre no Gym. Um membro da Equipe Rocket ir'#225' esbarrar em voc'#234'. O Gym est'#225' vazio.'
      ''
      'A CIDADE DE CERULEAN E A INS'#205'GNIA AZUL'
      ''
      'Saia do Gym, e saia da cidade pelo Norte. Voc'#234' encontrar'#225' o membro da Equipe Rocket. Derrote-o, '
      'e ele contar'#225' que escondeu um item no Gym. Volte ao Gym. O item '#233' o componente que est'#225' '
      'faltando na Usina de For'#231'a. Examine a pequena piscininha no meio do Gym. Entre nela. Examine o '
      'quadrado mais de cima na esquerda e voc'#234' pegar'#225' o Item.'
      ''
      'V'#225' ao norte novamente onde voc'#234' encontrou o membro da Equipe Rocket. Derrote os treinadores, '
      'e chegue numa jovem garota (Misty). Fale com ela e ela voltar'#225' ao Gym. Volte ao Gym e derrote-a '
      'para ganhar a ins'#237'gnia Azul. Volte at'#233' a Usina de For'#231'a e devolva o Item ao gord'#227'o da sala de '
      'm'#225'quinas. Ele lhe dar'#225' um TM em troca.'
      ''
      'Volte at'#233' Vermilion. Entre na casa abaixo do centro Pok'#233'mon. Fale com a mulher que fica girando. '
      'Ela lhe dar'#225' um boneco de um Clefairy.'
      ''
      'Volte at'#233' a cidade de Saffron, e entre em uma casa que fica na mesma linha de casa do Shop. '
      'Suba '
      'um andar. Fale com a mulher que est'#225' l'#225'. Ela lhe dar'#225' o item "Linear Motorcar Ticket". Agora voc'#234' '
      'pode trocar entre o mundo antigo e o novo facilmente !'
      ''
      'Voe at'#233' a cidade de Lavender, entre no maior pr'#233'dio da cidade e fale com um homem l'#225' dentro. Ele '
      'lhe dar'#225' um Radio melhor !!!'
      ''
      'A CIDADE DE CELADON E A INS'#205'GNIA DO ARCO-IRIS'
      ''
      'Volte at'#233' Saffron e saia da cidade pelo oeste. Voc'#234' chegar'#225' na cidade de Celadon. Derrote a lider '
      'do Gym, Erica, e ganhe a ins'#237'gnia do Arco Iris e o TM 16.'
      ''
      'A CIDADE DE FUSCHIA E A INS'#205'GNIA COR-DE-ROSA'
      ''
      'Saia de Celadon pelo oeste, e des'#231'a at'#233' a cidade de Fuschia. Entre no Gym e derrote Anju (o antigo '
      'lider era Koga, mas como ele est'#225' agora na Elite 5, veio essa tal de Anju). Ela '#233' a garota que est'#225' na '
      'parte esquerda do Gym. Ela lhe dar'#225' a ins'#237'gnia cor-de-rosa.'
      ''
      'A CIDADE DE PEWTER E A INS'#205'GNIA CINZA'
      ''
      'Volte a cidade de Vermilion e acorde Snorlax. Aperte Start, e entre no quarto menu. Coloque para a '
      'direita at'#233' voc'#234' ver um radio. Aperte Start, e coloque o r'#225'dio na pen'#250'ltima esta'#231#227'o poss'#237'vel (ela '
      'pega uma musica). Saia do menu do Start e examine o Snorlax. Prepare suas Pok'#233'-Bolas para '
      'captur'#225'-lo, pois ele s'#243' aparece uma vez no jogo !!!'
      ''
      'Quando voc'#234' matar/capturar o Snorlax, entre na caverna dos Digletts. Atravesse-a. Ao sair dela, v'#225' '
      'um pouco pra esquerda, e suba para chegar na cidade de Pewter. Derrote o l'#237'der do Gym, que '#233' '
      'Brock. Voc'#234' ganhar'#225' a ins'#237'gnia Cinza. Voc'#234' pode ir para Mt.Moon se quiser, voc'#234' enfrentar'#225' seu '
      'rival, e no final, tem uma loja, e um campo aberto.'
      ''
      'A CIDADE DE VIRIDIAN E A CIDADE DE PALLET'
      ''
      'Agora, v'#225' para o sul at'#233' a cidade de Viridian. o Gym est'#225' vazio. V'#225' para o Sul para a cidade de '
      'Pallet, e fale com o professor Oak.'
      ''
      'Surfe na '#225'gua abaixo da cidade de Pallet, e voc'#234' chegar'#225' numa ilha. Fale com a pessoa '
      'examinando uma rocha. Ele ir'#225' embora.'
      ''
      'A INS'#205'GNIA DE CREME'
      ''
      'Continue nadando para a direita, e voc'#234' chegar'#225' numa ilha. Entre na caverna da ilha. Essa '
      'carverna '#233' um Gym ! Derrote o Lider, Blaine, e ganhe a ins'#237'gnia de Creme.'
      ''
      'A CIDADE DE VIRIDIAN E A INS'#205'GNIA VERDE'
      ''
      'Volte a cidade de Viridian. Entre no Gym, voc'#234' lutar'#225' contra Gary ! Derrote-o e ganhe a ins'#237'gnia '
      'Verde.'
      ''
      'Parab'#233'ns ! Agora voc'#234' tem todas as 16 ins'#237'gnias !'
      ''
      'A MONTANHA DE SHIROGANE'
      ''
      'O que ?? Ainda tem mais ???'
      ''
      'Volte a cidade de Pallet. Fale com o professor Oak em seu laborat'#243'rio. Ele lhe contar'#225' sobre a '
      'montanha Shurogane, que possui Pok'#233'mons muito fortes. Volte a cidade de Viridian, e v'#225' para o '
      'este. Entre na casinha, e v'#225' para a esquerda, e voc'#234' chegar'#225' numa '#225'rea com Pok'#233'mons em level '
      '40 ou melhores. '#201' um bom lugar para voc'#234' evoluir seus Pok'#233'mons, pois tem um Centro Pok'#233'mon do '
      'lado. Voc'#234' pode voar para este centro pok'#233'mon usando o Fly !'
      ''
      'LUTANDO CONTRA O ASH'
      ''
      'Quando seus Pok'#233'mons estiverem beeeem fortes (level 80 a 90 !!) entre em uma caverna que h'#225' l'#225'. '
      'Voc'#234' encontrar'#225' algu'#233'm muito especial no final da caverna. '#201' Ash !!!'
      ''
      'Ele possui os MELHORES POK'#201'MONS DO JOGO !!!'
      ''
      'Os Pok'#233'mons dele s'#227'o:'
      ''
      'Pikachu - Level 81'
      ''
      'Blastoise - Level 77'
      ''
      'Venusaur - Level 77'
      ''
      'Eefi - Level 77'
      ''
      'Snorlax - Level 77'
      ''
      'Charizard - Level 77'
      ''
      'Quando voc'#234' derrotar Ash, voc'#234' zerou o jogo completamente !!! Parab'#233'ns !!!'
      ''
      'Agora que voc'#234' acabou o jogo, tente capturar o m'#225'ximo n'#250'mero de Pok'#233'mons poss'#237'vel. Quando '
      'n'#227'o tiver mais para capturar, use os c'#243'digos de GameShark para pegar os que faltam !!!'
      ''
      'Pegue todos os 251 !!!'
      ''
      'Agenda Pok'#233'mon da Pok'#233' Fight'
      'http://www.pokefight.cjb.net')
    ReadOnly = True
    ScrollBars = ssVertical
    TabOrder = 1
  end
